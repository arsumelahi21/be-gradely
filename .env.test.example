# Integration test environment (backend e2e).
# The e2e harness (test/setup-env.ts) already defaults to the values below, so
# a .env.test is optional locally. Override TEST_DATABASE_URL to point the
# suite at a different throwaway Postgres (e.g. in CI). NEVER point this at the
# dev/prod database — the suite truncates all tables between tests.

TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gradely_test?schema=public"
JWT_ACCESS_SECRET="test-access-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
