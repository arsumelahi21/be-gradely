# Gradely API — local development environment.
# Copy this file to `.env` (the agent is blocked from writing .env directly):
#     cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# Values below work out-of-the-box with the embedded local Postgres
# (scripts/local-db.mjs). Replace secrets before any shared/staging/prod use.

# --- Database (embedded local Postgres on port 5433) ---
# The pool params below matter most against a REMOTE Postgres (staging/prod):
# the app opens cold connections per query burst — each a TLS+auth handshake — so
# a high-latency link + a tiny default pool causes multi-second (up to ~15s) cold
# page loads. Apply these on the REAL .env of each environment (keep
# connection_limit × number-of-backend-instances <= the DB's max_connections):
#   connect_timeout=20  — let a slow cold handshake finish instead of aborting at
#                         Prisma's 5s default (which retries and compounds the wait).
#   connection_limit=15 — sized pool so requests don't queue under concurrent
#                         users. CRITICAL: connection_limit × number-of-instances
#                         must be <= the DB's max_connections (default 100), or
#                         requests starve and hang.
#   pool_timeout=20     — secondary: wait longer for a free connection before erroring.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gradely?schema=public&connection_limit=15&connect_timeout=20&pool_timeout=20"

# --- DB pool keep-alive (OPT-IN; local dev against a REMOTE DB only) ---
# When the DB is REMOTE, idle pool connections close and the next request pays a
# cold TLS handshake (slow). Set "on" to hold the pool warm (auto-sized to
# connection_limit-1, never oversubscribed). Leave UNSET in production: the
# backend is co-located with Postgres there, so it gives zero benefit and an
# oversized warmer once starved the prod pool. Default: off.
# DB_POOL_KEEPALIVE="on"

# --- Cache (optional) ---
# Leave unset for local dev: the cache falls back to an in-process store (no
# infra needed). Set to a Redis URL in staging/prod for a shared cache across
# instances, e.g. REDIS_URL="redis://:password@host:6379".
# REDIS_URL=""

# --- Server ---
PORT=3002

# --- CORS: comma-separated allow-list (frontend dev origin) ---
CORS_ORIGINS="http://localhost:3000"

# --- Frontend origin used to build password-reset links ---
FRONTEND_URL="http://localhost:3000"

# --- JWT (dev-only secrets; regenerate for real environments) ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- First super-admin bootstrap (used by scripts/create-super-admin.ts) ---
SUPER_ADMIN_EMAIL="superadmin@gradely.com"
SUPER_ADMIN_PASSWORD="Admin@12345678"

# --- AWS S3 (assignment file uploads). Placeholders so the app boots;
#     file upload/download won't work until real credentials are provided. ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
# AWS_S3_PREFIX is deprecated/unused: object keys are now foldered per-tenant by
# the school's `code` (e.g. `GHS/assignments/...`). The bucket stays in env; only
# the relative key is stored in the DB, so the bucket can be swapped freely.
AWS_S3_PRESIGN_EXPIRES_IN_SECONDS="900"

# --- Feature flags (beta) ---
# Real transactional email is OFF for beta (EmailService is a console stub until a
# provider is wired). In-app notifications work regardless. Set to "true" only once
# EmailService has a real backend (e.g. AWS SES).
EMAIL_NOTIFICATIONS_ENABLED="false"
